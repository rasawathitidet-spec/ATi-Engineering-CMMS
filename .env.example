# URL ของ Apps Script Web App (Deploy > Web app > URL ลงท้าย /exec)
APPS_SCRIPT_URL=
# รหัสลับที่ตั้งไว้ใน Script Properties ชื่อ API_KEY (ต้องตรงกัน)
APPS_SCRIPT_KEY=
# สตริงสุ่มยาว ๆ สำหรับเซ็น session (เช่น openssl rand -hex 32)
SESSION_SECRET=
# OAuth Client ID สำหรับ Google Sign-In (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# โดเมนอีเมลบริษัทที่อนุญาต (คั่นด้วย ,) เช่น ati.co.th
ALLOWED_EMAIL_DOMAINS=
